# Copy to .env and adjust. DATABASE_URL is also read without the MEDTIMELINE_ prefix.

# Local zero-config default (SQLite):
# DATABASE_URL=sqlite:///./medtimeline_dev.db

# PostgreSQL (recommended for shared/dev servers):
# DATABASE_URL=postgresql+psycopg://medtimeline:medtimeline@localhost:5432/medtimeline

MEDTIMELINE_STORAGE_DIR=./storage/reports
MEDTIMELINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
